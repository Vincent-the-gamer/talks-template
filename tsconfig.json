{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "markdown-it": ["./node_modules/.pnpm/node_modules/markdown-exit"],
    },
  },
  "exclude": ["**/*.md"],
}
